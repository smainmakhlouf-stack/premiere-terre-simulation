generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tables de Better Auth (connexion par e-mail et mot de passe + plugin admin).

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("user") // admin | user (vendeur)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  twoFactorEnabled Boolean? @default(false)

  sessions    Session[]
  twoFactors  TwoFactor[]
  accounts    Account[]
  clients     Client[]
  simulations Simulation[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Dossiers clients : chaque client appartient au vendeur qui l'a créé (les administrateurs voient tout).
// Si le compte du vendeur est supprimé, ses dossiers sont conservés sans conseiller (ownerId vide).

model Client {
  id        String   @id @default(cuid())
  nom       String
  prenom    String?
  email     String?
  telephone String?
  notes     String?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  simulations Simulation[]

  @@index([ownerId])
  @@map("clients")
}

model Simulation {
  id        String   @id @default(cuid())
  clientId  String
  nom       String
  /// État complet du simulateur (formulaire, prêts, diagnostic, emprunteurs).
  data      Json
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@map("simulations")
}

// Paramètres de l'équipe (une seule ligne, id "equipe"), modifiables par les administrateurs.
model Parametres {
  id        String   @id
  data      Json
  majPar    String?
  updatedAt DateTime @updatedAt

  @@map("parametres")
}

/// Double authentification (application d'authentification), gérée par Better Auth.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}
