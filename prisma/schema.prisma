generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Tables de Better Auth (connexion par e-mail et mot de passe + plugin admin).

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String?   @default("user") // admin | user (vendeur)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  twoFactorEnabled Boolean? @default(false)
  /// Téléphone du conseiller, repris dans les SMS envoyés aux clients.
  telephone     String?

  sessions    Session[]
  twoFactors  TwoFactor[]
  accounts    Account[]
  clients     Client[]
  simulations Simulation[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// Dossiers clients : chaque client appartient au vendeur qui l'a créé (les administrateurs voient tout).
// Si le compte du vendeur est supprimé, ses dossiers sont conservés sans conseiller (ownerId vide).

model Client {
  id        String   @id @default(cuid())
  nom       String
  prenom    String?
  /// Monsieur | Madame | Monsieur et Madame…
  civilite  String?
  /// Secteur (ville, quartier) du projet, repris dans les SMS.
  secteur   String?
  /// Co-emprunteur (couple)
  nom2      String?
  prenom2   String?
  email     String?
  telephone String?
  notes     String?
  /// en_cours | finance | perdu
  statut    String   @default("en_cours")
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  simulations Simulation[]
  sms         SmsEnvoi[]

  @@index([ownerId])
  @@map("clients")
}

model Simulation {
  id        String   @id @default(cuid())
  clientId  String
  nom       String
  /// État complet du simulateur (formulaire, prêts, diagnostic, emprunteurs).
  data      Json
  /// Chiffres clés (budget, montant emprunté, mensualité…) pour les listes et le tableau de bord.
  resume    Json?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author   User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions SimulationVersion[]

  @@index([clientId])
  @@map("simulations")
}

// Historique : chaque enregistrement conserve l'état précédent de la simulation (30 dernières versions).
model SimulationVersion {
  id           String   @id @default(cuid())
  simulationId String
  nom          String
  data         Json
  resume       Json?
  /// creation | modification | restauration | duplication
  action       String
  auteurNom    String?
  createdAt    DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, createdAt])
  @@map("simulation_versions")
}

// Paramètres de l'équipe (une seule ligne, id "equipe"), modifiables par les administrateurs.
model Parametres {
  id        String   @id
  data      Json
  majPar    String?
  /// Date de dernière modification de chaque rubrique (taux, plafondsLoyer…), pour les rappels.
  misesAJour Json?
  updatedAt DateTime @updatedAt

  @@map("parametres")
}

/// Double authentification (application d'authentification), gérée par Better Auth.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// SMS envoyés à un client depuis son dossier (relance « nous avons essayé de vous joindre »).
model SmsEnvoi {
  id        String   @id @default(cuid())
  clientId  String
  auteurNom String?
  telephone String
  texte     String
  /// envoye | echec
  statut    String
  erreur    String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("sms_envois")
}
