# Base PostgreSQL (renseignée automatiquement quand la base est reliée au projet sur Vercel)
DATABASE_URL=
# Longue chaîne aléatoire (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Clé API Resend (envoi des e-mails de mot de passe)
RESEND_API_KEY=
# Adresse e-mail autorisée à créer le premier compte administrateur sur /installation
ADMIN_EMAIL=
# Facultatif : expéditeur des e-mails (domaine vérifié sur Resend)
RESEND_FROM_EMAIL=Première Terre <noreply@premiereterre.fr>
# Facultatif : adresse du site (par défaut, l'adresse de production Vercel)
BETTER_AUTH_URL=https://simulation.premiereterre.fr
